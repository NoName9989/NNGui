-- HayxusLibrary (modern tab UI + miniBtn remember + createTab)
-- Author: (adapted for user)
-- Features:
--  - Protect & parent to CoreGui or gethui/syn protection
--  - Rayfield-style old GUI disabling (rename to -Old)
--  - Modern tab bar with horizontal scrolling and proper sizing
--  - Per-window mini button with remembered position and safe drag
--  - Restore previously selected tab
--  - Clean connection management (no global noisy InputChanged leaks)

local HayxusLibrary = {}
HayxusLibrary.__index = HayxusLibrary

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local function ProtectAndParent(gui)
    local ParentObj

    if gethui then
        ParentObj = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(gui)
        ParentObj = CoreGui
    elseif CoreGui:FindFirstChild("RobloxGui") then
        ParentObj = CoreGui.RobloxGui
    else
        ParentObj = CoreGui
    end

    -- 🌟 RAYFIELD: disable older GUIs with same name and rename them "-Old"
    for _, v in ipairs(ParentObj:GetChildren()) do
        if v.Name == gui.Name and v ~= gui then
            -- try to disable common GUI types safely
            if v:IsA("ScreenGui") then
                v.Enabled = false
            elseif v:FindFirstChildWhichIsA("Frame") and v.Parent then
                v.Parent = v.Parent -- no-op but safe
            end
            -- append suffix to avoid repeated matches
            local suffix = "-Old"
            if not v.Name:find("%-Old$") then
                pcall(function() v.Name = v.Name .. suffix end)
            end
        end
    end

    gui.Parent = ParentObj
end

local function addStroke(instance, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(0,0,0)
    stroke.Thickness = thickness or 1
    stroke.Parent = instance
    return stroke
end

local function makeLabel(parent, props)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.TextWrapped = false
    t.RichText = false
    for k,v in pairs(props or {}) do t[k] = v end
    t.Parent = parent
    return t
end

-- Utility: compute text width using TextService (reliable, no need to wait for TextBounds)
local function getTextWidth(text, font, textSize)
    local sizeVec = TextService:GetTextSize(tostring(text or ""), textSize or 14, font or Enum.Font.SourceSans, Vector2.new(2000, 2000))
    return math.ceil(sizeVec.X)
end

function HayxusLibrary:CreateWindow(title)
    local self = setmetatable({}, HayxusLibrary)

    -- persistent-ish state per instance
    self.MiniBtnPosition = self.MiniBtnPosition or UDim2.new(0,10,0,10)
    self.CurrentTabIndex = self.CurrentTabIndex or 1
    self.Tabs = {}
    self.TabButtons = {}

    local player = Players.LocalPlayer

    -- create gui
    local gui = Instance.new("ScreenGui")
    gui.Name = title or "HayxusWindow"
    gui.ResetOnSpawn = false
    ProtectAndParent(gui)

    -- main frame
    local frame = Instance.new("Frame")
    frame.Name = "HayxusFrame"
    frame.Size = UDim2.new(0,440,0,320)
    frame.Position = UDim2.new(0.5,-220,0.5,-160)
    frame.AnchorPoint = Vector2.new(0.5,0.5)
    frame.BackgroundColor3 = Color3.fromRGB(248,248,250)
    frame.BorderSizePixel = 0
    frame.Parent = gui
    self.Frame = frame

    local bgCorner = Instance.new("UICorner", frame)
    bgCorner.CornerRadius = UDim.new(0,12)
    addStroke(frame, Color3.fromRGB(220,220,225), 1)

    -- Titlebar
    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1,0,0,48)
    titleBar.Position = UDim2.new(0,0,0,0)
    titleBar.BackgroundTransparency = 0
    titleBar.BackgroundColor3 = Color3.fromRGB(255,255,255)
    titleBar.Parent = frame
    local tcorner = Instance.new("UICorner", titleBar)
    tcorner.CornerRadius = UDim.new(0,12)

    local titleLabel = makeLabel(titleBar, {
        Size = UDim2.new(0.7,-20,1,0),
        Position = UDim2.new(0,16,0,0),
        Text = title or "Hayxus",
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        TextColor3 = Color3.fromRGB(18,18,20),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    })

    -- right controls container
    local controls = Instance.new("Frame", titleBar)
    controls.Size = UDim2.new(0,140,1,0)
    controls.Position = UDim2.new(1,-148,0,0)
    controls.BackgroundTransparency = 1

    -- minimize button (icon style)
    local minimizeBtn = Instance.new("TextButton", controls)
    minimizeBtn.Size = UDim2.new(0,36,0,28)
    minimizeBtn.Position = UDim2.new(1,-92,0,10)
    minimizeBtn.BackgroundColor3 = Color3.fromRGB(240,240,245)
    minimizeBtn.Text = "_"
    minimizeBtn.Font = Enum.Font.GothamBold
    minimizeBtn.TextSize = 18
    minimizeBtn.TextColor3 = Color3.fromRGB(40,40,40)
    minimizeBtn.AutoButtonColor = false
    local minCorner = Instance.new("UICorner", minimizeBtn)
    minCorner.CornerRadius = UDim.new(0,6)
    addStroke(minimizeBtn, Color3.fromRGB(220,220,225))

    -- close button
    local closeBtn = Instance.new("TextButton", controls)
    closeBtn.Size = UDim2.new(0,36,0,28)
    closeBtn.Position = UDim2.new(1,-48,0,10)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255,80,80)
    closeBtn.Text = "✕"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 16
    closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
    closeBtn.AutoButtonColor = false
    local closeCorner = Instance.new("UICorner", closeBtn)
    closeCorner.CornerRadius = UDim.new(0,6)

    -- Tab bar container (under title)
    local tabBarOuter = Instance.new("Frame")
    tabBarOuter.Size = UDim2.new(1,-24,0,46)
    tabBarOuter.Position = UDim2.new(0,12,0,56)
    tabBarOuter.BackgroundTransparency = 1
    tabBarOuter.Parent = frame

    local tabBar = Instance.new("ScrollingFrame", tabBarOuter)
    tabBar.Name = "TabBar"
    tabBar.ScrollingDirection = Enum.ScrollingDirection.X
    tabBar.AutomaticCanvasSize = Enum.AutomaticSize.X
    tabBar.Size = UDim2.new(1,0,1,0)
    tabBar.Position = UDim2.new(0,0,0,0)
    tabBar.BackgroundTransparency = 1
    tabBar.ScrollBarThickness = 6
    tabBar.HorizontalScrollBarInset = Enum.ScrollBarInset.Always
    tabBar.CanvasSize = UDim2.new(0,0,0,0)

    -- layout trong tabBar
    local tabLayout = Instance.new("UIListLayout", tabBar)
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Padding = UDim.new(0,8)

    local tabPadding = Instance.new("UIPadding", tabBar)
    tabPadding.PaddingLeft = UDim.new(0,6)

    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabBar.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X + 12, 0, 0)
    end)

    -- content area below tabs
    local contentOuter = Instance.new("Frame")
    contentOuter.Size = UDim2.new(1,-24,1, -130)
    contentOuter.Position = UDim2.new(0,12,0,108)
    contentOuter.BackgroundTransparency = 1
    contentOuter.Parent = frame

    -- border for content
    local contentBg = Instance.new("Frame", contentOuter)
    contentBg.Size = UDim2.new(1,0,1,0)
    contentBg.Position = UDim2.new(0,0,0,0)
    contentBg.BackgroundColor3 = Color3.fromRGB(255,255,255)
    contentBg.BackgroundTransparency = 0
    local contentCorner = Instance.new("UICorner", contentBg)
    contentCorner.CornerRadius = UDim.new(0,10)
    addStroke(contentBg, Color3.fromRGB(230,230,235), 1)

    -- container inside content for each tab
    local contentContainer = Instance.new("Frame", contentBg)
    contentContainer.Size = UDim2.new(1,0,1,0)
    contentContainer.Position = UDim2.new(0,0,0,0)
    contentContainer.BackgroundTransparency = 1

    -- draggable for main frame (titleBar)
    do
        local dragging, dragStart, startPos = false, nil, nil
        local connInputChanged
        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
                local endedConn
                endedConn = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        endedConn:Disconnect()
                    end
                end)
            end
        end)
        connInputChanged = UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                           startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        -- cleanup on gui destroy
        gui.Destroying:Connect(function()
            if connInputChanged and connInputChanged.Disconnect then pcall(connInputChanged.Disconnect, connInputChanged) end
        end)
    end

    -- store references
    self.Gui = gui
    self.Frame = frame
    self.TabBar = tabBar
    self.ContentContainer = contentContainer
    self.Tabs = {}
    self.TabButtons = {}
    self.CurrentTabIndex = self.CurrentTabIndex or 1

    local function setActiveButton(btn, active)
        if not btn or not btn:IsA("TextButton") and not btn:IsA("Frame") then return end
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(145,195,255)
            if btn._lbl then btn._lbl.TextColor3 = Color3.fromRGB(14,28,48) end
        else
            btn.BackgroundColor3 = Color3.fromRGB(240,240,246)
            if btn._lbl then btn._lbl.TextColor3 = Color3.fromRGB(60,60,70) end
        end
    end

    --- CreateTab: returns the content ScrollingFrame you can parent items into
    function self:CreateTab(name, iconId)
        assert(name and type(name) == "string", "CreateTab: name (string) required")

        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = "TabButton_"..name
        tabBtn.BackgroundColor3 = Color3.fromRGB(240,240,246)
        tabBtn.BorderSizePixel = 0
        tabBtn.AutoButtonColor = false
        tabBtn.Size = UDim2.new(0, 120, 1, 0) -- temporary, we'll set proper width
        tabBtn.Parent = tabBar
        local tbtnCorner = Instance.new("UICorner", tabBtn)
        tbtnCorner.CornerRadius = UDim.new(0,8)
        addStroke(tabBtn, Color3.fromRGB(220,220,225),1)

        -- icon
        local icon = Instance.new("ImageLabel", tabBtn)
        icon.Name = "Icon"
        icon.Size = UDim2.new(0,20,0,20)
        icon.Position = UDim2.new(0,10,0.5,-10)
        icon.BackgroundTransparency = 1
        icon.Image = iconId or ""
        icon.ScaleType = Enum.ScaleType.Fit

        -- label
        local lbl = Instance.new("TextLabel", tabBtn)
        lbl.Name = "TabLabel"
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(0,0,1,0)
        lbl.Position = UDim2.new(0,36,0,0)
        lbl.Text = tostring(name)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.TextColor3 = Color3.fromRGB(60,60,70)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.AutomaticSize = Enum.AutomaticSize.X

        tabBtn._lbl = lbl

        -- compute width using TextService (reliable)
        local textWidth = getTextWidth(lbl.Text, lbl.Font, lbl.TextSize)
        local totalWidth = 36 + textWidth + 16 -- icon + text + padding
        tabBtn.Size = UDim2.new(0, math.clamp(totalWidth, 80, 600), 1, 0)

        -- content frame (scrolling)
        local content = Instance.new("ScrollingFrame")
        content.Name = "TabContent_"..name
        content.Size = UDim2.new(1,-18,1,-18)
        content.Position = UDim2.new(0,9,0,9)
        content.BackgroundTransparency = 1
        content.ScrollBarThickness = 6
        content.CanvasSize = UDim2.new(0,0,0,0)
        content.AutomaticCanvasSize = Enum.AutomaticSize.Y
        content.Parent = contentContainer
        content.Visible = false

        local contentLayout = Instance.new("UIListLayout", content)
        contentLayout.Padding = UDim.new(0,8)
        contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        local contentPadding = Instance.new("UIPadding", content)
        contentPadding.PaddingTop = UDim.new(0,10)
        contentPadding.PaddingLeft = UDim.new(0,10)
        contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            content.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y + 12)
        end)

        -- hover/click visuals
        tabBtn.MouseEnter:Connect(function()
            if not content.Visible then tabBtn.BackgroundColor3 = Color3.fromRGB(230,230,238) end
        end)
        tabBtn.MouseLeave:Connect(function()
            if not content.Visible then tabBtn.BackgroundColor3 = Color3.fromRGB(240,240,246) end
        end)

        local index = #self.Tabs + 1
        tabBtn.MouseButton1Click:Connect(function()
            for i,t in ipairs(self.Tabs) do
                t.Content.Visible = false
                setActiveButton(self.TabButtons[i], false)
            end
            content.Visible = true
            setActiveButton(tabBtn, true)
            self.CurrentTabIndex = index
            -- ensure selected tab is scrolled into view
            pcall(function()
                tabBar:ScrollTo(tabBtn.AbsolutePosition.X - tabBar.AbsolutePosition.X - 20)
            end)
        end)

        table.insert(self.Tabs, {Name = name, Content = content})
        table.insert(self.TabButtons, tabBtn)

        if #self.Tabs == 1 then
            content.Visible = true
            setActiveButton(tabBtn, true)
            self.CurrentTabIndex = 1
        end

        return content
    end

    -- Restore previously selected tab (safe)
    function self:RestoreTab()
        local idx = tonumber(self.CurrentTabIndex) or 1
        idx = math.clamp(idx, 1, #self.Tabs)
        for i, t in ipairs(self.Tabs) do
            t.Content.Visible = (i == idx)
            setActiveButton(self.TabButtons[i], i == idx)
        end
        -- scroll selected tab into view (deferred)
        if self.TabButtons[idx] then
            RunService.Heartbeat:Wait()
            pcall(function()
                local btn = self.TabButtons[idx]
                tabBar.CanvasPosition = Vector2.new(math.max(0, btn.AbsolutePosition.X - tabBar.AbsolutePosition.X - 20), 0)
            end)
        end
    end

    -- minimize / mini button with remembered position
    do
        local minimized = false
        local miniBtn = nil
        local dragConn, inputChangedConn

        local function createMini()
            miniBtn = Instance.new("ImageButton")
            miniBtn.Name = "HayxusMiniBtn"
            miniBtn.Size = UDim2.new(0,56,0,56)
            miniBtn.Position = self.MiniBtnPosition or UDim2.new(0,10,0,10)
            miniBtn.AnchorPoint = Vector2.new(0,0)
            miniBtn.Image = "rbxassetid://98966772841112"
            miniBtn.BackgroundTransparency = 0
            miniBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
            miniBtn.Parent = gui
            local mcorner = Instance.new("UICorner", miniBtn); mcorner.CornerRadius = UDim.new(0,12)
            addStroke(miniBtn, Color3.fromRGB(220,220,225), 1)
            local maspect = Instance.new("UIAspectRatioConstraint", miniBtn); maspect.AspectRatio = 1

            -- drag handling (local scoped)
            local draggingMini = false
            local startInputPos, startPos
            local endedConn
            miniBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingMini = true
                    startInputPos = input.Position
                    startPos = miniBtn.Position
                    endedConn = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            draggingMini = false
                            if endedConn then endedConn:Disconnect(); endedConn = nil end
                            -- save final
                            self.MiniBtnPosition = miniBtn.Position
                        end
                    end)
                end
            end)
            inputChangedConn = UIS.InputChanged:Connect(function(input)
                if draggingMini and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local delta = input.Position - startInputPos
                    miniBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                                  startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                    -- live save (less often)
                    self.MiniBtnPosition = miniBtn.Position
                end
            end)

            miniBtn.MouseButton1Click:Connect(function()
                if miniBtn then
                    pcall(function() miniBtn:Destroy() end)
                    miniBtn = nil
                end
                frame.Visible = true
                minimized = false
                -- restore active tab
                self:RestoreTab()
                -- disconnect inputChangedConn
                if inputChangedConn then inputChangedConn:Disconnect(); inputChangedConn = nil end
            end)

            -- cleanup when gui destroyed
            gui.Destroying:Connect(function()
                if inputChangedConn then inputChangedConn:Disconnect(); inputChangedConn = nil end
            end)
        end

        minimizeBtn.MouseButton1Click:Connect(function()
            if minimized then return end
            minimized = true
            frame.Visible = false
            createMini()
        end)
    end

    -- close: destroy only this gui
    closeBtn.MouseButton1Click:Connect(function()
        if gui and gui.Destroy then
            gui:Destroy()
        end
    end)

    -- expose small API
    function self:Destroy()
        if self.Gui and self.Gui.Destroy then self.Gui:Destroy() end
    end

    function self:GetGui()
        return self.Gui
    end

    function self:GetFrame()
        return self.Frame
    end

    -- restore tab if stored index present
    -- call after user created tabs, but safe to call here (no-op if none)
    RunService.Heartbeat:Wait()
    pcall(function() self:RestoreTab() end)

    return self
end

return HayxusLibrary
