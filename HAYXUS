local HayxusLibrary = {}
HayxusLibrary.__index = HayxusLibrary

-- Helper: set GUI vào CoreGui / gethui / syn
local function ProtectAndParent(gui)
    local CoreGui = game:GetService("CoreGui")
    if gethui then
        gui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(gui)
        gui.Parent = CoreGui
    elseif CoreGui:FindFirstChild("RobloxGui") then
        gui.Parent = CoreGui.RobloxGui
    else
        gui.Parent = CoreGui
    end
end

function HayxusLibrary:CreateWindow(title)
    local self = setmetatable({}, HayxusLibrary)
    self.MiniBtnPosition = self.MiniBtnPosition or UDim2.new(0,10,0,10)
    self.Tabs = {}
    self.CurrentTab = nil

    local player = game.Players.LocalPlayer
    local gui = Instance.new("ScreenGui")
    gui.Name = title
    gui.ResetOnSpawn = false
    ProtectAndParent(gui)

    -- Main frame
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0,400,0,300)
    frame.Position = UDim2.new(0.5,-200,0.5,-150)
    frame.BackgroundColor3 = Color3.fromRGB(255,255,255)
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel = 0
    frame.Parent = gui
    self.Frame = frame

    -- Title bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1,0,0,45)
    titleBar.Position = UDim2.new(0,0,0,0)
    titleBar.BackgroundColor3 = Color3.fromRGB(255,255,255)
    titleBar.BackgroundTransparency = 0.2
    titleBar.BorderSizePixel = 0
    titleBar.Parent = frame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(0.7,-10,1,0)
    titleLabel.Position = UDim2.new(0,10,0,0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.TextColor3 = Color3.fromRGB(0,0,0)
    titleLabel.Text = title
    titleLabel.Font = Enum.Font.GothamSemibold
    titleLabel.TextSize = 20
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = titleBar

    -- Close button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0,30,0,30)
    closeBtn.Position = UDim2.new(1,-35,0,8)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255,80,80)
    closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
    closeBtn.Text = "X"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 18
    closeBtn.Parent = titleBar
    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

    -- Minimize button
    local minimizeBtn = Instance.new("TextButton")
    minimizeBtn.Size = UDim2.new(0,30,0,30)
    minimizeBtn.Position = UDim2.new(1,-70,0,8)
    minimizeBtn.BackgroundColor3 = Color3.fromRGB(200,200,200)
    minimizeBtn.TextColor3 = Color3.fromRGB(0,0,0)
    minimizeBtn.Text = "_"
    minimizeBtn.Font = Enum.Font.GothamBold
    minimizeBtn.TextSize = 18
    minimizeBtn.Parent = titleBar

    -- Draggable main frame
    local UIS = game:GetService("UserInputService")
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset + delta.X,
                                       startPos.Y.Scale,startPos.Y.Offset + delta.Y)
        end
    end)

    local sideBar = Instance.new("Frame")
sideBar.Size = UDim2.new(0, 150, 1, -45)
sideBar.Position = UDim2.new(0, 0, 0, 45)
sideBar.BackgroundColor3 = Color3.fromRGB(30,30,30)
sideBar.BorderSizePixel = 0
sideBar.Parent = frame
self.SideBar = sideBar

    local contentFrame = Instance.new("Frame")
    contentFrame.Size = UDim2.new(1,0,1,-85)
    contentFrame.Position = UDim2.new(0,0,0,85)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Parent = frame
    self.ContentFrame = contentFrame

    function self:AddTab(name, iconId)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 45)
    tabBtn.Position = UDim2.new(0, 0, 0, (#self.Tabs)*45)
    tabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    tabBtn.Text = ""
    tabBtn.BorderSizePixel = 0
    tabBtn.Parent = self.SideBar

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 24, 0, 24)
    icon.Position = UDim2.new(0, 12, 0.5, -12)
    icon.BackgroundTransparency = 1
    icon.Image = iconId or ""
    icon.ImageColor3 = Color3.fromRGB(200,200,200)
    icon.Parent = tabBtn

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.new(0, 45, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.Font = Enum.Font.Gotham
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(200,200,200)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = tabBtn

    local line = Instance.new("Frame")
    line.Size = UDim2.new(0, 3, 1, 0)
    line.Position = UDim2.new(0, 0, 0, 0)
    line.BackgroundColor3 = Color3.fromRGB(255,255,255)
    line.Visible = false
    line.Parent = tabBtn

    local tabContent = Instance.new("Frame")
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.Visible = false
    tabContent.Parent = self.ContentFrame

    local function setActive(state)
        if state then
            tabBtn.BackgroundColor3 = Color3.fromRGB(50,50,50)
            label.TextColor3 = Color3.fromRGB(255,255,255)
            icon.ImageColor3 = Color3.fromRGB(255,255,255)
            line.Visible = true
        else
            tabBtn.BackgroundColor3 = Color3.fromRGB(30,30,30)
            label.TextColor3 = Color3.fromRGB(200,200,200)
            icon.ImageColor3 = Color3.fromRGB(200,200,200)
            line.Visible = false
        end
    end

    tabBtn.MouseButton1Click:Connect(function()
        if self.CurrentTab then
            self.CurrentTab.Visible = false
            self.CurrentTab.ActiveTab(false)
        end
        tabContent.Visible = true
        self.CurrentTab = tabContent
        tabContent.ActiveTab = setActive
        setActive(true)
    end)

    table.insert(self.Tabs, tabContent)
    if #self.Tabs == 1 then
        tabContent.Visible = true
        self.CurrentTab = tabContent
        tabContent.ActiveTab = setActive
        setActive(true)
    end

    return tabContent
end

    -- Minimize button logic
    local minimized = false
    local miniBtn
    minimizeBtn.MouseButton1Click:Connect(function()
        if minimized then return end
        minimized = true
        frame.Visible = false

        miniBtn = Instance.new("ImageButton")
        miniBtn.Size = UDim2.new(0,60,0,60)
        miniBtn.Position = self.MiniBtnPosition
        miniBtn.BackgroundTransparency = 1
        miniBtn.Image = "rbxassetid://98966772841112"
        miniBtn.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0,12)
        corner.Parent = miniBtn

        local aspect = Instance.new("UIAspectRatioConstraint")
        aspect.AspectRatio = 1
        aspect.Parent = miniBtn

        -- Drag miniBtn
        local dragging2, dragStart2, startPos2
        miniBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging2 = true
                dragStart2 = input.Position
                startPos2 = miniBtn.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging2 = false
                    end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging2 then
                local delta = input.Position - dragStart2
                miniBtn.Position = UDim2.new(startPos2.X.Scale,startPos2.X.Offset+delta.X,
                                             startPos2.Y.Scale,startPos2.Y.Offset+delta.Y)
                self.MiniBtnPosition = miniBtn.Position
            end
        end)

        miniBtn.MouseButton1Click:Connect(function()
            miniBtn:Destroy()
            frame.Visible = true
            minimized = false
        end)
    end)

    return self
end

return HayxusLibrary
