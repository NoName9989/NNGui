-- HayxusLibrary Mobile Optimized
local HayxusLibrary = {}
HayxusLibrary.__index = HayxusLibrary

local function ProtectAndParent(gui)
    local CoreGui = game:GetService("CoreGui")
    local ParentObj

    if gethui then
        ParentObj = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(gui)
        ParentObj = CoreGui
    elseif CoreGui:FindFirstChild("RobloxGui") then
        ParentObj = CoreGui.RobloxGui
    else
        ParentObj = CoreGui
    end

    -- Disable old GUIs
    for _, v in ipairs(ParentObj:GetChildren()) do
        if v.Name == gui.Name and v ~= gui then
            v.Enabled = false
            v.Name = gui.Name.."-Old"
        end
    end

    gui.Parent = ParentObj
end

local function addStroke(inst, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(0,0,0)
    stroke.Thickness = thickness or 1
    stroke.Parent = inst
    return stroke
end

local function makeLabel(parent, props)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    for k,v in pairs(props or {}) do t[k] = v end
    t.Parent = parent
    return t
end

function HayxusLibrary:CreateWindow(title)
    local self = setmetatable({}, HayxusLibrary)

    local UIS = game:GetService("UserInputService")

    self.MiniBtnPosition = self.MiniBtnPosition or UDim2.new(0,10,0,10)
    self.CurrentTabIndex = self.CurrentTabIndex or 1
    self.Tabs = {}
    self.TabButtons = {}

    -- GUI
    local gui = Instance.new("ScreenGui")
    gui.Name = title
    gui.ResetOnSpawn = false
    ProtectAndParent(gui)

    -- Main frame
    local frame = Instance.new("Frame")
    frame.Name = "HayxusFrame"
    frame.Size = UDim2.new(0,440,0,360)
    frame.Position = UDim2.new(0.5,-220,0.5,-180)
    frame.BackgroundColor3 = Color3.fromRGB(248,248,250)
    frame.BorderSizePixel = 0
    frame.Parent = gui
    local bgCorner = Instance.new("UICorner", frame)
    bgCorner.CornerRadius = UDim.new(0,12)
    addStroke(frame, Color3.fromRGB(220,220,225))

    -- TitleBar
    local titleBar = Instance.new("Frame", frame)
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1,0,0,48)
    titleBar.Position = UDim2.new(0,0,0,0)
    titleBar.BackgroundColor3 = Color3.fromRGB(255,255,255)
    local tcorner = Instance.new("UICorner", titleBar)
    tcorner.CornerRadius = UDim.new(0,12)

    local titleLabel = makeLabel(titleBar, {
        Size = UDim2.new(0.7,-20,1,0),
        Position = UDim2.new(0,16,0,0),
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        TextColor3 = Color3.fromRGB(18,18,20),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    })

    -- Controls
    local controls = Instance.new("Frame", titleBar)
    controls.Size = UDim2.new(0,120,1,0)
    controls.Position = UDim2.new(1,-128,0,0)
    controls.BackgroundTransparency = 1

    local minimizeBtn = Instance.new("TextButton", controls)
    minimizeBtn.Size = UDim2.new(0,36,0,28)
    minimizeBtn.Position = UDim2.new(1,-92,0,10)
    minimizeBtn.BackgroundColor3 = Color3.fromRGB(240,240,245)
    minimizeBtn.Text = "_"
    minimizeBtn.Font = Enum.Font.GothamBold
    minimizeBtn.TextSize = 18
    minimizeBtn.TextColor3 = Color3.fromRGB(40,40,40)
    minimizeBtn.AutoButtonColor = false
    local minCorner = Instance.new("UICorner", minimizeBtn)
    minCorner.CornerRadius = UDim.new(0,6)
    addStroke(minimizeBtn, Color3.fromRGB(220,220,225))

    local closeBtn = Instance.new("TextButton", controls)
    closeBtn.Size = UDim2.new(0,36,0,28)
    closeBtn.Position = UDim2.new(1,-48,0,10)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255,80,80)
    closeBtn.Text = "✕"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 16
    closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
    closeBtn.AutoButtonColor = false
    local closeCorner = Instance.new("UICorner", closeBtn)
    closeCorner.CornerRadius = UDim.new(0,6)

    -- TabBar
    local tabBarOuter = Instance.new("Frame", frame)
    tabBarOuter.Name = "TabHostBar"
    tabBarOuter.Size = UDim2.new(1, -24, 0, 50)
    tabBarOuter.Position = UDim2.new(0,12,0,56)
    tabBarOuter.BackgroundColor3 = Color3.fromRGB(255,255,255)
    tabBarOuter.BorderSizePixel = 0
    local tOuterCorner = Instance.new("UICorner", tabBarOuter)
    tOuterCorner.CornerRadius = UDim.new(0,8)
    addStroke(tabBarOuter, Color3.fromRGB(230,230,235))

    local tabBar = Instance.new("ScrollingFrame", tabBarOuter)
    tabBar.Name = "TabBar"
    tabBar.Size = UDim2.new(1,-12,1,-12)
    tabBar.Position = UDim2.new(0,6,0,6)
    tabBar.BackgroundTransparency = 1
    tabBar.ScrollBarThickness = 0
    tabBar.ScrollingDirection = Enum.ScrollingDirection.X

    local tabLayout = Instance.new("UIListLayout", tabBar)
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.Padding = UDim.new(0,8)
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local tabPadding = Instance.new("UIPadding", tabBar)
    tabPadding.PaddingLeft = UDim.new(0,6)

    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabBar.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X + 12, 0, 0)
    end)

    -- Content
    local contentOuter = Instance.new("Frame", frame)
    contentOuter.Size = UDim2.new(1,-24,1,-130)
    contentOuter.Position = UDim2.new(0,12,0,108)
    contentOuter.BackgroundTransparency = 1

    local contentBg = Instance.new("Frame", contentOuter)
    contentBg.Size = UDim2.new(1,0,1,0)
    contentBg.BackgroundColor3 = Color3.fromRGB(255,255,255)
    local contentCorner = Instance.new("UICorner", contentBg)
    contentCorner.CornerRadius = UDim.new(0,10)
    addStroke(contentBg, Color3.fromRGB(230,230,235))

    local contentContainer = Instance.new("Frame", contentBg)
    contentContainer.Size = UDim2.new(1,0,1,0)
    contentContainer.BackgroundTransparency = 1

    -- Draggable
    do
        local dragging, startPos, startInput = false, nil, nil
        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                startInput = input.Position
                startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
                local delta = input.Position - startInput
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                           startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    self.Gui = gui
    self.Frame = frame
    self.TabBar = tabBar
    self.ContentContainer = contentContainer
    self.Tabs = {}
    self.TabButtons = {}
    self.CurrentTabIndex = self.CurrentTabIndex or 1

    local function setActiveButton(btn, active)
        if not btn then return end
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(145,195,255)
            if btn._lbl then btn._lbl.TextColor3 = Color3.fromRGB(14,28,48) end
        else
            btn.BackgroundColor3 = Color3.fromRGB(240,240,246)
            if btn._lbl then btn._lbl.TextColor3 = Color3.fromRGB(60,60,70) end
        end
    end

    function self:CreateTab(name, iconId)
        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = "TabButton_"..name
        tabBtn.BackgroundColor3 = Color3.fromRGB(240,240,246)
        tabBtn.AutoButtonColor = false
        tabBtn.Text = ""
        tabBtn.Size = UDim2.new(0,0,1,0)
        tabBtn.Parent = tabBar
        local tcorner = Instance.new("UICorner", tabBtn)
        tcorner.CornerRadius = UDim.new(0,10)
        addStroke(tabBtn, Color3.fromRGB(220,220,225))

        local icon = Instance.new("ImageLabel", tabBtn)
        icon.Size = UDim2.new(0,24,0,24)
        icon.Position = UDim2.new(0,10,0.5,-12)
        icon.BackgroundTransparency = 1
        icon.Image = iconId or ""
        icon.ScaleType = Enum.ScaleType.Fit

        local lbl = Instance.new("TextLabel", tabBtn)
        lbl.Size = UDim2.new(0,0,1,0)
        lbl.Position = UDim2.new(0,36,0,0)
        lbl.Text = name
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 16
        lbl.TextColor3 = Color3.fromRGB(60,60,70)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.AutomaticSize = Enum.AutomaticSize.X
        lbl.BackgroundTransparency = 1

        tabBtn._lbl = lbl
        tabBtn.Size = UDim2.new(0,36+lbl.TextBounds.X+12,1,0)

        local content = Instance.new("ScrollingFrame", contentContainer)
        content.Name = "TabContent_"..name
        content.Size = UDim2.new(1,-18,1,-18)
        content.Position = UDim2.new(0,9,0,9)
        content.BackgroundTransparency = 1
        content.ScrollBarThickness = 6
        content.CanvasSize = UDim2.new(0,0,0,0)
        content.Visible = false

        local layout = Instance.new("UIListLayout", content)
        layout.Padding = UDim.new(0,8)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        local pad = Instance.new("UIPadding", content)
        pad.PaddingTop = UDim.new(0,10)
        pad.PaddingLeft = UDim.new(0,10)

        tabBtn.MouseButton1Click:Connect(function()
            for i,t in ipairs(self.Tabs) do
                t.Content.Visible = false
                setActiveButton(self.TabButtons[i], false)
            end
            content.Visible = true
            setActiveButton(tabBtn,true)
            self.CurrentTabIndex = #self.Tabs + 1
        end)

        table.insert(self.Tabs,{Name=name,Content=content})
        table.insert(self.TabButtons,tabBtn)

        if #self.Tabs == 1 then
            content.Visible = true
            setActiveButton(tabBtn,true)
        end

        return content
    end

    function self:RestoreTab()
        local idx = math.clamp(tonumber(self.CurrentTabIndex) or 1,1,#self.Tabs)
        for i,t in ipairs(self.Tabs) do
            t.Content.Visible = (i==idx)
            setActiveButton(self.TabButtons[i], i==idx)
        end
    end

    -- Mini button
    do
        local minimized=false
        local miniBtn=nil
        minimizeBtn.MouseButton1Click:Connect(function()
            if minimized then return end
            minimized=true
            frame.Visible=false
            miniBtn=Instance.new("ImageButton", gui)
            miniBtn.Name="HayxusMiniBtn"
            miniBtn.Size=UDim2.new(0,56,0,56)
            miniBtn.Position=self.MiniBtnPosition
            miniBtn.Image="rbxassetid://98966772841112"
            miniBtn.BackgroundColor3=Color3.fromRGB(255,255,255)
            miniBtn.BackgroundTransparency=0
            local mcorner=Instance.new("UICorner", miniBtn); mcorner.CornerRadius=UDim.new(0,12)
            addStroke(miniBtn, Color3.fromRGB(220,220,225),1)
            local maspect=Instance.new("UIAspectRatioConstraint", miniBtn); maspect.AspectRatio=1

            -- drag
            local dragMini, startInput, startPosMini=false,nil,nil
            miniBtn.InputBegan:Connect(function(input)
                if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                    dragMini=true
                    startInput=input.Position
                    startPosMini=miniBtn.Position
                    input.Changed:Connect(function()
                        if input.UserInputState==Enum.UserInputState.End then
                            dragMini=false
                            self.MiniBtnPosition=miniBtn.Position
                        end
                    end)
                end
            end)
            UIS.InputChanged:Connect(function(input)
                if dragMini and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
                    local delta=input.Position-startInput
                    miniBtn.Position=UDim2.new(startPosMini.X.Scale,startPosMini.X.Offset+delta.X,
                                               startPosMini.Y.Scale,startPosMini.Y.Offset+delta.Y)
                    self.MiniBtnPosition=miniBtn.Position
                end
            end)

            miniBtn.MouseButton1Click:Connect(function()
                miniBtn:Destroy()
                frame.Visible=true
                minimized=false
                self:RestoreTab()
            end)
        end)
    end

    closeBtn.MouseButton1Click:Connect(function()
        if gui then gui:Destroy() end
    end)

    return self
end

return HayxusLibrary
