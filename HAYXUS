local HayxusLibrary = {}
HayxusLibrary.__index = HayxusLibrary

function HayxusLibrary:CreateWindow(title)
    local self = setmetatable({}, HayxusLibrary)
    local player = game.Players.LocalPlayer

    -- Tạo GUI
    local gui = Instance.new("ScreenGui")
    gui.Name = title
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    -- Frame chính
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 400, 0, 300)
    frame.Position = UDim2.new(0.5, -200, 0.5, -150)
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel = 0
    frame.Parent = gui
    self.Frame = frame

    -- Title bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 45)
    titleBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    titleBar.BackgroundTransparency = 0.2
    titleBar.BorderSizePixel = 0
    titleBar.Parent = frame

    -- Title label
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(0.7, -10, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
    titleLabel.Text = title
    titleLabel.Font = Enum.Font.GothamSemibold
    titleLabel.TextSize = 20
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = titleBar

    -- Close button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 8)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Text = "X"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 18
    closeBtn.Parent = titleBar
    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    -- Minimize button
    local minimizeBtn = Instance.new("TextButton")
    minimizeBtn.Size = UDim2.new(0, 30, 0, 30)
    minimizeBtn.Position = UDim2.new(1, -70, 0, 8)
    minimizeBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    minimizeBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    minimizeBtn.Text = "_"
    minimizeBtn.Font = Enum.Font.GothamBold
    minimizeBtn.TextSize = 18
    minimizeBtn.Parent = titleBar

    -- Drag Frame chính
    local UIS = game:GetService("UserInputService")
    local dragging, dragStart, startPos

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- Minimized button setup
    local minimized = false
    self.MiniBtnPosition = self.MiniBtnPosition or UDim2.new(0, 10, 0, 10)
    local miniBtn

    local function createMiniBtn()
        miniBtn = Instance.new("ImageButton")
        miniBtn.Size = UDim2.new(0, 60, 0, 60)
        miniBtn.Position = self.MiniBtnPosition
        miniBtn.BackgroundTransparency = 1
        miniBtn.BorderSizePixel = 0
        miniBtn.Image = "rbxassetid://134140295627868" -- ID ảnh
        miniBtn.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = miniBtn

        local aspect = Instance.new("UIAspectRatioConstraint")
        aspect.AspectRatio = 1
        aspect.Parent = miniBtn

        -- Drag mini button
        local dragMini, startDrag, startMiniPos
        miniBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragMini = true
                startDrag = input.Position
                startMiniPos = miniBtn.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragMini = false
                        self.MiniBtnPosition = miniBtn.Position -- lưu vị trí
                    end
                end)
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragMini and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - startDrag
                miniBtn.Position = UDim2.new(
                    startMiniPos.X.Scale, startMiniPos.X.Offset + delta.X,
                    startMiniPos.Y.Scale, startMiniPos.Y.Offset + delta.Y
                )
            end
        end)

        miniBtn.MouseButton1Click:Connect(function()
            miniBtn:Destroy()
            frame.Visible = true
            minimized = false
        end)
    end

    minimizeBtn.MouseButton1Click:Connect(function()
        if minimized then return end
        minimized = true
        frame.Visible = false
        createMiniBtn()
    end)

    self.ElementCount = 0
    return self
end

return HayxusLibrary
