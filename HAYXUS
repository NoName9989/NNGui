local HayxusLibrary = {}
HayxusLibrary.__index = HayxusLibrary

-- ==============================
-- PROTECT & AUTO CLOSE OLD GUI
-- ==============================
local function ProtectAndParent(gui)
    local CoreGui = game:GetService("CoreGui")
    local ParentObj

    if gethui then
        ParentObj = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(gui)
        ParentObj = CoreGui
    elseif CoreGui:FindFirstChild("RobloxGui") then
        ParentObj = CoreGui.RobloxGui
    else
        ParentObj = CoreGui
    end

    -- AUTO CLOSE GUI CŨ (cơ chế Rayfield)
    for _, v in ipairs(ParentObj:GetChildren()) do
        if v.Name == gui.Name and v ~= gui then
            v.Enabled = false
            v.Name = gui.Name .. "-Old"
        end
    end

    gui.Parent = ParentObj
end

-- ==============================
-- CREATE WINDOW
-- ==============================
function HayxusLibrary:CreateWindow(title)
    local self = setmetatable({}, HayxusLibrary)
    self.MiniBtnPosition = self.MiniBtnPosition or UDim2.new(0, 10, 0, 10)
    self.Tabs = {}
    self.CurrentTab = nil

    -- GUI khung
    local gui = Instance.new("ScreenGui")
    gui.Name = title
    gui.ResetOnSpawn = false
    ProtectAndParent(gui)

    -- Frame chính
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 480, 0, 360)
    frame.Position = UDim2.new(0.5, -240, 0.5, -180)
    frame.BackgroundColor3 = Color3.fromRGB(255,255,255)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = gui
    self.Frame = frame

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

    -- ==============================
    -- TITLE BAR
    -- ==============================
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 45)
    titleBar.BackgroundColor3 = Color3.fromRGB(240,240,240)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = frame
    Instance.new("UICorner", titleBar).CornerRadius = UDim.new(0, 12)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(0.7, -10, 1, 0)
    titleLabel.Position = UDim2.new(0, 12, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.TextColor3 = Color3.fromRGB(0,0,0)
    titleLabel.Text = title
    titleLabel.Font = Enum.Font.GothamSemibold
    titleLabel.TextSize = 20
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = titleBar

    -- CLOSE BUTTON
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 32, 0, 32)
    closeBtn.Position = UDim2.new(1, -40, 0, 6)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255,80,80)
    closeBtn.Text = "X"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 18
    closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
    closeBtn.Parent = titleBar
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0,6)

    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    -- MINIMIZE BUTTON
    local minimizeBtn = Instance.new("TextButton")
    minimizeBtn.Size = UDim2.new(0, 32, 0, 32)
    minimizeBtn.Position = UDim2.new(1, -80, 0, 6)
    minimizeBtn.BackgroundColor3 = Color3.fromRGB(200,200,200)
    minimizeBtn.Text = "_"
    minimizeBtn.Font = Enum.Font.GothamBold
    minimizeBtn.TextSize = 20
    minimizeBtn.TextColor3 = Color3.fromRGB(0,0,0)
    minimizeBtn.Parent = titleBar
    Instance.new("UICorner", minimizeBtn).CornerRadius = UDim.new(0,6)

    -- DRAG WINDOW
    local UIS = game:GetService("UserInputService")
    local dragging, dragStart, startPos

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                       startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- ==============================
    -- TAB BAR
    -- ==============================
    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1, -20, 0, 42)
    tabBar.Position = UDim2.new(0, 10, 0, 55)
    tabBar.BackgroundTransparency = 1
    tabBar.Parent = frame
    self.TabBar = tabBar

    -- CONTENT
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -20, 1, -110)
    content.Position = UDim2.new(0, 10, 0, 105)
    content.BackgroundTransparency = 1
    content.Parent = frame
    self.Content = content

    -- ==============================
    -- TAB CREATOR
    -- ==============================
    function self:CreateTab(name, iconId)
        local index = #self.Tabs
        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(0, 110, 1, 0)
        tabBtn.Position = UDim2.new(0, index * 115, 0, 0)
        tabBtn.BackgroundColor3 = Color3.fromRGB(225,225,225)
        tabBtn.Text = ""
        tabBtn.Parent = tabBar
        Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0,8)

        -- icon
        local img = Instance.new("ImageLabel")
        img.Size = UDim2.new(0, 22, 0, 22)
        img.Position = UDim2.new(0, 10, 0.5, -11)
        img.BackgroundTransparency = 1
        img.Image = "rbxassetid://"..tostring(iconId or 0)
        img.Parent = tabBtn

        -- text
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, -40, 1, 0)
        txt.Position = UDim2.new(0, 40, 0, 0)
        txt.BackgroundTransparency = 1
        txt.Text = name
        txt.Font = Enum.Font.GothamMedium
        txt.TextSize = 16
        txt.TextColor3 = Color3.fromRGB(30,30,30)
        txt.TextXAlignment = Enum.TextXAlignment.Left
        txt.Parent = tabBtn

        local tabContent = Instance.new("Frame")
        tabContent.Size = UDim2.new(1,0,1,0)
        tabContent.Visible = false
        tabContent.BackgroundTransparency = 1
        tabContent.Parent = content

        tabBtn.MouseButton1Click:Connect(function()
            if self.CurrentTab then self.CurrentTab.Visible = false end
            tabContent.Visible = true
            self.CurrentTab = tabContent

            -- highlight
            for _, child in ipairs(tabBar:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 = Color3.fromRGB(225,225,225)
                end
            end
            tabBtn.BackgroundColor3 = Color3.fromRGB(200,200,255)
        end)

        if #self.Tabs == 0 then
            tabContent.Visible = true
            self.CurrentTab = tabContent
            tabBtn.BackgroundColor3 = Color3.fromRGB(200,200,255)
        end

        table.insert(self.Tabs, tabContent)
        return tabContent
    end

    -- ==============================
    -- MINIMIZE BUTTON
    -- ==============================
    local minimized = false
    local miniBtn

    minimizeBtn.MouseButton1Click:Connect(function()
        if minimized then return end
        minimized = true
        frame.Visible = false

        miniBtn = Instance.new("ImageButton")
        miniBtn.Size = UDim2.new(0, 55, 0, 55)
        miniBtn.Position = self.MiniBtnPosition
        miniBtn.BackgroundTransparency = 1
        miniBtn.Image = "rbxassetid://98966772841112"
        miniBtn.Parent = gui
        Instance.new("UICorner", miniBtn).CornerRadius = UDim.new(0, 12)

        -- Drag mini button
        local dragging2, dragStart2, startPos2
        miniBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or 
               input.UserInputType == Enum.UserInputType.Touch then
                dragging2 = true
                dragStart2 = input.Position
                startPos2 = miniBtn.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging2 = false
                    end
                end)
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragging2 then
                local delta = input.Position - dragStart2
                miniBtn.Position = UDim2.new(startPos2.X.Scale, startPos2.X.Offset + delta.X,
                                            startPos2.Y.Scale, startPos2.Y.Offset + delta.Y)
                self.MiniBtnPosition = miniBtn.Position
            end
        end)

        miniBtn.MouseButton1Click:Connect(function()
            miniBtn:Destroy()
            frame.Visible = true
            minimized = false
        end)
    end)

    return self
end

return HayxusLibrary
